<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
</head>
<body>

{% if page == "home" %}
    <h1>Welcome</h1>
    <p>This is the home page.</p>
{% endif %}

{% if page == "students" %}
    <h1>All Students</h1>
    <ul>
        {% for s in students %}
            <li>{{ s.first_name }} {{ s.last_name }}</li>
        {% endfor %}
    </ul>
{% endif %}

{% if page == "add" %}
    <h1>Add Student</h1>
    <form method="post">
        <input name="first_name">
        <input name="last_name">
        <button>Add</button>
    </form>
{% endif %}

</body>
</html>
@app.route("/")
def home():
    return render_template("app.html", page="home", title="Home")

@app.route("/students")
def students():
    conn = get_db_connection()
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT * FROM students")
    data = cursor.fetchall()
    return render_template("app.html", page="students", title="Students", students=data)

